{
  "name": "@fxvrlxss/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
